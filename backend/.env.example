# ==== OnBus backend — exemplo de variáveis de ambiente ====
# Copie este arquivo para .env e preencha com valores reais.
# O .env NUNCA deve ser versionado.

PORT=3000
NODE_ENV=development

# Segredo único para assinar e verificar todos os JWT.
# Gere um forte com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-forte

# Credenciais do painel admin. A senha é guardada como hash bcrypt, não em texto puro.
# Gere o hash com: node -e "console.log(require('bcrypt').hashSync('SUA_SENHA',10))"
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD_HASH=coloque-o-hash-bcrypt-aqui

# Chave de serviço do Firebase em base64 (evita deixar o .json solto e facilita o deploy).
# Gere com: node -e "console.log(Buffer.from(require('fs').readFileSync('firebaseServiceAccount.json')).toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_B64=coloque-o-base64-aqui

# Origens permitidas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:9000
