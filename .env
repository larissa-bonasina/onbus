# URL base da API do OnBus. Não é segredo (fica visível no navegador),
# mas centraliza o valor em vez de espalhar "http://localhost:3000" pelo código.
# Para apontar pra outro backend localmente, crie um .env.local (gitignorado) com o mesmo nome.
VITE_API_URL=http://localhost:3000

# Chave do Google Maps (Maps JavaScript API + Routes API). Coloque em .env.local:
VITE_GOOGLE_MAPS_KEY=
# Sem ela, o mapa usa OpenStreetMap (só para desenvolvimento).
